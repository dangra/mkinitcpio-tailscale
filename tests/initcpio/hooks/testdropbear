#!/usr/bin/ash
# shellcheck shell=bash
# Test-only mkinitcpio runtime hook: starts the dropbear laid down by
# tests/initcpio/install/testdropbear.
#
# Runs after the tailscale hook (HOOKS order), which has already mounted
# devpts -- dropbear needs a pty for the session the test opens. Listening on
# the wildcard address is the point of the exercise: inbound tailnet TCP
# reaches this daemon through tailscaled's userspace loopback proxy, never
# through a network interface.
#
# It is scaffolding for the test suite and is not part of the shipped package.

run_hook() {
	msg "testdropbear: starting dropbear"
	# No `ip link set lo up` here on purpose: the shipped tailscale runtime
	# hook is responsible for it, and this scenario failing without it is
	# exactly the coverage that keeps that line from being dropped.
	# Foreground with stderr logging, backgrounded by the shell and pinned to
	# the console: letting dropbear daemonise detaches its stderr, and even -F
	# loses it once init moves on, so the redirect is what actually gets the
	# log into the boot test's captured console. The default pid file lives
	# under /var/run, which a busybox image does not guarantee.
	mkdir -p /var/run
	dropbear -F -E -r /etc/dropbear/dropbear_ed25519_host_key >/dev/console 2>&1 &
}

# vim: noexpandtab
